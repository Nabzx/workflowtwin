# Copy to .env for local development. These values are for local use only.
WORKFLOWTWIN_SERVICE_NAME=workflowtwin-api
WORKFLOWTWIN_ENVIRONMENT=local
WORKFLOWTWIN_LOG_LEVEL=INFO
WORKFLOWTWIN_DATABASE_URL=postgresql+asyncpg://workflowtwin:workflowtwin@localhost:5432/workflowtwin
WORKFLOWTWIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required to enable POST /api/v1/demo/reset outside local or test mode.
WORKFLOWTWIN_DEMO_RESET_TOKEN=
# Set only for the unified production image; local Vite development leaves this empty.
WORKFLOWTWIN_WEB_DIST_PATH=

# Leave empty for local Vite proxying. The hosted frontend sets this to the
# separately deployed API origin: https://workflowtwin-api.vercel.app
VITE_API_BASE_URL=

# Used by the local PostgreSQL container.
POSTGRES_DB=workflowtwin
POSTGRES_USER=workflowtwin
POSTGRES_PASSWORD=workflowtwin
POSTGRES_PORT=5432
WEB_PORT=3000
API_PORT=8000
